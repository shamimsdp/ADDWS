{
  "name": "inventory-management-system",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=10.0.0 <11.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:migrations": "node --test scripts/deploy-test-migrations.test.mjs",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "turbo run db:generate",
    "db:migrate:dev": "turbo run db:migrate:dev",
    "db:migrate:deploy": "turbo run db:migrate:deploy",
    "db:status": "turbo run db:status",
    "db:drift": "turbo run db:drift",
    "db:seed": "turbo run db:seed",
    "queue": "node scripts/feature-queue.mjs",
    "delivery:mode": "node scripts/delivery-mode.mjs",
    "test:delivery": "node --test scripts/delivery.test.mjs",
    "agents:dashboard": "node tools/agent-dashboard/server.mjs",
    "agents:report": "node tools/agent-dashboard/report.mjs",
    "agents:test": "node --test tools/agent-dashboard/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
